{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173,
      "url": "http://127.0.0.1:5173"
    },
    {
      "name": "frontend-live-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "env": {
        "PORT": "5174",
        "API_PROXY": "https://jarvis-hacknation.onrender.com"
      },
      "port": 5174,
      "url": "http://127.0.0.1:5174"
    }
  ]
}